# Python
.venv/
__pycache__/
*.pyc
.DS_Store

# Build artifacts (editable install)
*.egg-info/
build/
dist/

# Generated deck packages (regenerate from the .py generators)
*.apkg
decks/*/out/

# Local agent/investigation logs (noise, not source)
.kiro-agents/
investigation/
kiro-notes/
findings/

# study/ material is versioned, but not its intermediate images or venv
decks/*/study/img/
decks/*/study/img_*/
decks/*/study/.venv/

# qa/ scripts + reports are versioned; large raw intermediates are not
decks/*/qa/**/batches/
decks/*/qa/**/reviews/
decks/*/qa/**/candidates/
decks/*/qa/**/blind_batches/
decks/*/qa/**/blind_prompts/

# Deck backups (local safety copies)
decks/*/backups/

# dedup: regenerable knowledge-base corpus
decks/*/dedupe/existing_corpus/

# dedup: regenerable universe artifacts (rebuilt from Anki + local anytime)
decks/*/dedupe/universe_cards.json
decks/*/dedupe/universe_skipped.json
decks/*/dedupe/universe_conflicts.json

# dedup: regenerable vector stores (embeddings, rebuilt by build_vector_store*.py)
decks/*/dedupe/vecstore/
decks/*/dedupe/vecstore_v2/

# exam extractor scratch (regenerable from the pasted exam)
decks/*/dedupe/blocks/
decks/*/dedupe/extracted.jsonl
decks/*/dedupe/segments.json
